<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_anim_slide_in_bottom" parentIn="0">
    <name>OuzFX Anim · Slide In from Bottom</name>
    <description>Slides in from the bottom edge in 12 frames (expo ease-out) with directional motion blur.</description>
    <effect id="qtblend">
        <property name="rect">0q=0 2112 1080 1920 1;12=0 0 1080 1920 1</property>
        <property name="rotation">0=0;12=0</property>
        <property name="compositing">0</property>
        <property name="distort">0</property>
        <property name="rotate_anchor">0=0.5 0.5 0 0;12=0.5 0.5 0 0</property>
    </effect>
    <effect id="avfilter.dblur">
        <property name="av.angle">0=90;6=90;12=90</property>
        <property name="av.radius">0=60;6=10;12=0</property>
        <property name="av.planes">7</property>
    </effect>
</effectgroup>
