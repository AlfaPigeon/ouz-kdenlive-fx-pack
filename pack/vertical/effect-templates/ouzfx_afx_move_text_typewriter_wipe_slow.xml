<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_afx_move_text_typewriter_wipe_slow" parentIn="0">
    <name>OuzFX AFX_Move_Text_Typewriter_Wipe_Slow</name>
    <description>Linear left-to-right crop reveal that uncovers a line of text over 50 frames (2 s @25 fps). Put it on a title clip; drag the last keyframe to change the speed.</description>
    <effect id="qtcrop">
        <property name="rect">0=0 0 1 1920;50=0 0 1080 1920</property>
        <property name="radius">0=0;50=0</property>
        <property name="circle">0</property>
        <property name="color">0=0x00000000;50=0x00000000</property>
    </effect>
    <effect id="boxblur">
        <property name="blur">0=0</property>
        <property name="hori">0=1</property>
        <property name="vert">0=1</property>
    </effect>
</effectgroup>
