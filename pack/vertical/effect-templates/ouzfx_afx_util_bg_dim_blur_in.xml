<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_afx_util_bg_dim_blur_in" parentIn="0">
    <name>OuzFX AFX_Util_BG_Dim_Blur_In</name>
    <description>Background layer: dims to 55% and blurs over 12 frames so text / overlays on the track above become legible.</description>
    <effect id="brightness">
        <property name="level">0h=1;12=0.55</property>
    </effect>
    <effect id="avfilter.gblur">
        <property name="av.sigma">0h=0;12=14</property>
        <property name="av.sigmaV">0h=0;12=14</property>
        <property name="av.steps">1</property>
        <property name="av.planes">15</property>
    </effect>
</effectgroup>
