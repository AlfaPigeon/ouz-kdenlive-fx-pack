<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_text_rise" parentIn="0">
    <name>OuzFX Text · Text Rise</name>
    <description>Rises 6% and fades in over 12 frames – clean lower-third / callout entry.</description>
    <effect id="qtblend">
        <property name="rect">0h=0 115 1080 1920 0;12=0 0 1080 1920 1</property>
        <property name="rotation">0=0;12=0</property>
        <property name="compositing">0</property>
        <property name="distort">0</property>
        <property name="rotate_anchor">0=0.5 0.5 0 0;12=0.5 0.5 0 0</property>
    </effect>
    <effect id="boxblur">
        <property name="blur">0=2;8=0</property>
        <property name="hori">0=1;8=1</property>
        <property name="vert">0=1;8=1</property>
    </effect>
</effectgroup>
