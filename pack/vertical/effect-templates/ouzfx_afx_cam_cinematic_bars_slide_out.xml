<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_afx_cam_cinematic_bars_slide_out" parentIn="0">
    <name>OuzFX AFX_Cam_Cinematic_Bars_Slide_Out</name>
    <description>Out half of the letterbox: 2.39:1 bars retract over 15 frames, leaving 'movie mode'. Pair with 'Look · Cinematic Bars Slide-In'.</description>
    <effect id="qtcrop">
        <property name="rect">0h=0 734 1080 452;15=0 0 1080 1920</property>
        <property name="radius">0=0;15=0</property>
        <property name="circle">0</property>
        <property name="color">0=0x000000ff;15=0x000000ff</property>
    </effect>
    <effect id="boxblur">
        <property name="blur">0=0</property>
        <property name="hori">0=1</property>
        <property name="vert">0=1</property>
    </effect>
</effectgroup>
