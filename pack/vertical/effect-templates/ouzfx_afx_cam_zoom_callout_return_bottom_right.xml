<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_afx_cam_zoom_callout_return_bottom_right" parentIn="0">
    <name>OuzFX AFX_Cam_Zoom_Callout_Return_Bottom_Right</name>
    <description>Return half of the callout: from the 180% bottom-right zoom (Screen Zoom · Zoom to Bottom-Right) smoothly back to 100% in 15 frames. Razor where the callout ends.</description>
    <effect id="qtblend">
        <property name="rect">0i=-864 -1536 1944 3456 1;15=0 0 1080 1920 1</property>
        <property name="rotation">0=0;15=0</property>
        <property name="compositing">0</property>
        <property name="distort">0</property>
        <property name="rotate_anchor">0=0.5 0.5 0 0;15=0.5 0.5 0 0</property>
    </effect>
    <effect id="boxblur">
        <property name="blur">0=0;5=2;12=0</property>
        <property name="hori">0=1;5=1;12=1</property>
        <property name="vert">0=1;5=1;12=1</property>
    </effect>
</effectgroup>
