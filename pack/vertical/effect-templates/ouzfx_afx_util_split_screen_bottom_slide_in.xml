<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_afx_util_split_screen_bottom_slide_in" parentIn="0">
    <name>OuzFX AFX_Util_Split_Screen_Bottom_Slide_In</name>
    <description>Same as Split_Screen_Bottom, but the half slides in from the bottom edge (15 frames, cubic ease-out).</description>
    <effect id="qtcrop">
        <property name="rect">0=0 480 1080 960</property>
        <property name="radius">0=0</property>
        <property name="circle">0</property>
        <property name="color">0=0x00000000</property>
    </effect>
    <effect id="qtblend">
        <property name="rect">0h=0 1920 1080 1920 1;15=0 480 1080 1920 1</property>
        <property name="rotation">0=0;15=0</property>
        <property name="compositing">0</property>
        <property name="distort">0</property>
        <property name="rotate_anchor">0=0.5 0.5 0 0;15=0.5 0.5 0 0</property>
    </effect>
</effectgroup>
