<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_anim_whip_in" parentIn="0">
    <name>OuzFX Anim · Whip-In</name>
    <description>Very fast slide from the right with heavy motion blur (6 frames).</description>
    <effect id="qtblend">
        <property name="rect">0q=1080 0 1080 1920 1;6=0 0 1080 1920 1</property>
        <property name="rotation">0=0;6=0</property>
        <property name="compositing">0</property>
        <property name="distort">0</property>
        <property name="rotate_anchor">0=0.5 0.5 0 0;6=0.5 0.5 0 0</property>
    </effect>
    <effect id="avfilter.dblur">
        <property name="av.angle">0=0;4=0;6=0</property>
        <property name="av.radius">0=150;4=30;6=0</property>
        <property name="av.planes">7</property>
    </effect>
</effectgroup>
