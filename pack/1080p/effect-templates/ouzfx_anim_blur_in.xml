<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_anim_blur_in" parentIn="0">
    <name>OuzFX Anim · Blur-In</name>
    <description>Starts heavily blurred and transparent, resolves to sharp in 15 frames.</description>
    <effect id="avfilter.gblur">
        <property name="av.sigma">0h=40;15=0</property>
        <property name="av.sigmaV">0h=40;15=0</property>
        <property name="av.steps">1</property>
        <property name="av.planes">15</property>
    </effect>
    <effect id="qtblend">
        <property name="rect">0h=-38 -22 1997 1123 0;15=0 0 1920 1080 1</property>
        <property name="rotation">0=0;15=0</property>
        <property name="compositing">0</property>
        <property name="distort">0</property>
        <property name="rotate_anchor">0=0.5 0.5 0 0;15=0.5 0.5 0 0</property>
    </effect>
</effectgroup>
