<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_zoom_punch_in_out" parentIn="0">
    <name>OuzFX Zoom · Punch In-Out (Beat)</name>
    <description>Zooms to 120% on frame 2 and settles back by frame 10. Drop one on every beat.</description>
    <effect id="qtblend">
        <property name="rect">0q=0 0 1920 1080 1;2h=-192 -108 2304 1296 1;10=0 0 1920 1080 1</property>
        <property name="rotation">0=0;2=0;10=0</property>
        <property name="compositing">0</property>
        <property name="distort">0</property>
        <property name="rotate_anchor">0=0.5 0.5 0 0;2=0.5 0.5 0 0;10=0.5 0.5 0 0</property>
    </effect>
    <effect id="boxblur">
        <property name="blur">0=4;3=1;8=0</property>
        <property name="hori">0=1;3=1;8=1</property>
        <property name="vert">0=1;3=1;8=1</property>
    </effect>
</effectgroup>
