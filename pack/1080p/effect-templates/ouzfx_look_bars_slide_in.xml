<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_look_bars_slide_in" parentIn="0">
    <name>OuzFX Look · Cinematic Bars Slide-In</name>
    <description>2.39:1 letterbox bars glide in over 15 frames – 'movie moment' / dramatic beat.</description>
    <effect id="qtcrop">
        <property name="rect">0h=0 0 1920 1080;15=0 138 1920 803</property>
        <property name="radius">0=0;15=0</property>
        <property name="circle">0</property>
        <property name="color">0=0x000000ff;15=0x000000ff</property>
    </effect>
    <effect id="vignette">
        <property name="radius">0.8</property>
        <property name="smooth">0.7</property>
        <property name="opacity">0.45</property>
        <property name="mode">0</property>
    </effect>
</effectgroup>
