<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_afx_cam_zoom_callout_return_top_left" parentIn="0">
    <name>OuzFX AFX_Cam_Zoom_Callout_Return_Top_Left</name>
    <description>Return half of the callout: from the 180% top-left zoom (Screen Zoom · Zoom to Top-Left) smoothly back to 100% in 15 frames. Razor where the callout ends.</description>
    <effect id="qtblend">
        <property name="rect">0i=0 0 3456 1944 1;15=0 0 1920 1080 1</property>
        <property name="rotation">0=0;15=0</property>
        <property name="compositing">0</property>
        <property name="distort">0</property>
        <property name="rotate_anchor">0=0.5 0.5 0 0;15=0.5 0.5 0 0</property>
    </effect>
    <effect id="boxblur">
        <property name="blur">0=0;5=2;12=0</property>
        <property name="hori">0=1;5=1;12=1</property>
        <property name="vert">0=1;5=1;12=1</property>
    </effect>
</effectgroup>
