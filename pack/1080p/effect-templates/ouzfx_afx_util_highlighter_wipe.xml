<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_afx_util_highlighter_wipe" parentIn="0">
    <name>OuzFX AFX_Util_Highlighter_Wipe</name>
    <description>Put it on a yellow Color clip above an article/PDF shot: a 45%-opacity marker band wipes on left-to-right in 12 frames. Move/resize the Transform rectangle over the line you want to highlight.</description>
    <effect id="qtcrop">
        <property name="rect">0h=0 0 1 1080;12=0 0 1920 1080</property>
        <property name="radius">0=0;12=0</property>
        <property name="circle">0</property>
        <property name="color">0=0x00000000;12=0x00000000</property>
    </effect>
    <effect id="qtblend">
        <property name="rect">0=192 486 1536 97 0.45</property>
        <property name="rotation">0=0</property>
        <property name="compositing">0</property>
        <property name="distort">1</property>
        <property name="rotate_anchor">0=0.5 0.5 0 0</property>
    </effect>
</effectgroup>
