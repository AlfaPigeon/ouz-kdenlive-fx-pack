<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_afx_audio_walkie_talkie_radio" parentIn="0" type="customAudio">
    <name>OuzFX AFX_Audio_Walkie_Talkie_Radio</name>
    <description>Narrow 500–2600 Hz radio band with light bit-crush overdrive and hard limiter compression – walkie-talkie / police radio callouts.</description>
    <effect id="avfilter.highpass">
        <property name="av.f">500</property>
        <property name="av.t">q</property>
        <property name="av.w">0.707</property>
        <property name="av.p">2</property>
        <property name="av.m">1</property>
    </effect>
    <effect id="avfilter.lowpass">
        <property name="av.f">0=2600</property>
        <property name="av.t">q</property>
        <property name="av.w">0=0.707</property>
        <property name="av.p">2</property>
        <property name="av.m">0=1</property>
    </effect>
    <effect id="avfilter.lowpass">
        <property name="av.f">0=2600</property>
        <property name="av.t">q</property>
        <property name="av.w">0=0.707</property>
        <property name="av.p">2</property>
        <property name="av.m">0=1</property>
    </effect>
    <effect id="avfilter.acrusher">
        <property name="av.bits">7</property>
        <property name="av.mix">0.35</property>
        <property name="av.mode">log</property>
        <property name="av.aa">0.7</property>
        <property name="av.samples">1</property>
    </effect>
    <effect id="avfilter.alimiter">
        <property name="av.level_in">4</property>
        <property name="av.level_out">1</property>
        <property name="av.limit">0.5</property>
        <property name="av.attack">2</property>
        <property name="av.release">40</property>
        <property name="av.asc">0</property>
        <property name="av.level">0</property>
    </effect>
</effectgroup>
