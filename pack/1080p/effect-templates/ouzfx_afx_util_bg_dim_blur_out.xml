<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_afx_util_bg_dim_blur_out" parentIn="0">
    <name>OuzFX AFX_Util_BG_Dim_Blur_Out</name>
    <description>Brings a dimmed + blurred background back to normal over 12 frames (pair with Dim_Blur_In).</description>
    <effect id="brightness">
        <property name="level">0h=0.55;12=1</property>
    </effect>
    <effect id="avfilter.gblur">
        <property name="av.sigma">0h=14;12=0</property>
        <property name="av.sigmaV">0h=14;12=0</property>
        <property name="av.steps">1</property>
        <property name="av.planes">15</property>
    </effect>
</effectgroup>
