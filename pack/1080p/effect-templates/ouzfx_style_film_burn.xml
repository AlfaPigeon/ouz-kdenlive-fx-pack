<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_style_film_burn" parentIn="0">
    <name>OuzFX Stylize · Film Burn Flash</name>
    <description>Warm orange over-exposure with glow that peaks at frame 6 and clears by 16.</description>
    <effect id="frei0r.colorize">
        <property name="hue">0=0.07;6=0.07;16=0.07</property>
        <property name="saturation">0=0.0;6f=0.85;16=0.0</property>
        <property name="lightness">0=0.5;6f=0.68;16=0.5</property>
    </effect>
    <effect id="frei0r.glow">
        <property name="Blur">0=0.0;6f=0.35;16=0.0</property>
    </effect>
    <effect id="brightness">
        <property name="level">0=1.0;6f=1.9;16=1.0</property>
    </effect>
</effectgroup>
