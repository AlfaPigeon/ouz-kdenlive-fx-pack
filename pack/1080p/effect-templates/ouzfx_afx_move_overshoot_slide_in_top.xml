<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_afx_move_overshoot_slide_in_top" parentIn="0">
    <name>OuzFX AFX_Move_Overshoot_Slide_In_Top</name>
    <description>Slides in from the top edge, overshoots its resting spot by ~8% and settles back (14 frames, back ease-out) with a short motion-blur peak.</description>
    <effect id="qtblend">
        <property name="rect">0w=0 -1134 1920 1080 1;14=0 0 1920 1080 1</property>
        <property name="rotation">0=0;14=0</property>
        <property name="compositing">0</property>
        <property name="distort">0</property>
        <property name="rotate_anchor">0=0.5 0.5 0 0;14=0.5 0.5 0 0</property>
    </effect>
    <effect id="avfilter.dblur">
        <property name="av.angle">0=90;5=90;14=90</property>
        <property name="av.radius">0=40;5=6;14=0</property>
        <property name="av.planes">7</property>
    </effect>
</effectgroup>
