<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_afx_cam_whip_pan_push_down" parentIn="0">
    <name>OuzFX AFX_Cam_Whip_Pan_Push_Down</name>
    <description>Last 8 frames of a clip: whips the picture out down with heavy directional blur. Razor 8 frames before the cut and drop it on the right-hand piece (left version = 'Fast · Motion-Blur Push Left').</description>
    <effect id="qtblend">
        <property name="rect">0p=0 0 1920 1080 1;8=0 1080 1920 1080 1</property>
        <property name="rotation">0=0;8=0</property>
        <property name="compositing">0</property>
        <property name="distort">0</property>
        <property name="rotate_anchor">0=0.5 0.5 0 0;8=0.5 0.5 0 0</property>
    </effect>
    <effect id="avfilter.dblur">
        <property name="av.angle">0=90;3=90;8=90</property>
        <property name="av.radius">0=0;3=70;8=160</property>
        <property name="av.planes">7</property>
    </effect>
</effectgroup>
