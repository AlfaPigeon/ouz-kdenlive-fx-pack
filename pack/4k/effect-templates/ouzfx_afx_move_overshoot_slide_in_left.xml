<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_afx_move_overshoot_slide_in_left" parentIn="0">
    <name>OuzFX AFX_Move_Overshoot_Slide_In_Left</name>
    <description>Slides in from the left edge, swings past its resting spot and settles back (14 frames, Kdenlive/MLT back ease-out – the overshoot peaks at ≈ 37% of the travel) with a short motion-blur peak.</description>
    <effect id="qtblend">
        <property name="rect">0w=-4032 0 3840 2160 1;14=0 0 3840 2160 1</property>
        <property name="rotation">0=0;14=0</property>
        <property name="compositing">0</property>
        <property name="distort">0</property>
        <property name="rotate_anchor">0=0.5 0.5 0 0;14=0.5 0.5 0 0</property>
    </effect>
    <effect id="avfilter.dblur">
        <property name="av.angle">0=0;5=0;14=0</property>
        <property name="av.radius">0=40;5=6;14=0</property>
        <property name="av.planes">7</property>
    </effect>
</effectgroup>
