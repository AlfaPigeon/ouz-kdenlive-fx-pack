<?xml version="1.0" encoding="UTF-8"?>
<effectgroup id="ouzfx_style_vhs" parentIn="0">
    <name>OuzFX Stylize · VHS Tape</name>
    <description>Scanlines, chroma bleed, soft blur, noise and slightly washed colour – instant 90s tape.</description>
    <effect id="avfilter.chromashift">
        <property name="av.cbh">6</property>
        <property name="av.crh">-6</property>
        <property name="av.cbv">0</property>
        <property name="av.crv">0</property>
        <property name="av.edge">0</property>
    </effect>
    <effect id="avfilter.gblur">
        <property name="av.sigma">1.2</property>
        <property name="av.sigmaV">0.4</property>
        <property name="av.steps">1</property>
        <property name="av.planes">15</property>
    </effect>
    <effect id="grain">
        <property name="noise">18</property>
        <property name="contrast">100</property>
        <property name="brightness">100</property>
    </effect>
    <effect id="frei0r.scanline0r"/>
</effectgroup>
